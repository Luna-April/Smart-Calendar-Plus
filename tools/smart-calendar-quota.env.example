# Copy to ~/.config/smart-calendar-quota.env.
# Update the URL if the ESP32 gets a different DHCP address.
SMART_CALENDAR_URL=http://ESP32_IP

# If the desktop uses a local proxy for internet access, uncomment and adjust.
# NO_PROXY must include the ESP32 IP so /quota stays on the LAN.
# HTTP_PROXY=http://127.0.0.1:7890/
# HTTPS_PROXY=http://127.0.0.1:7890/
# ALL_PROXY=socks://127.0.0.1:7890/
# NO_PROXY=ESP32_IP,localhost,127.0.0.1
