# ESP32-C3 native USB Serial/JTAG (VID 303A, PID 1001) access for the active desktop user.
# Only affects Espressif USB Serial/JTAG devices, not the USB camera on ttyACM0.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", MODE="0666", GROUP="dialout"
SUBSYSTEM=="usb", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", MODE="0666"
